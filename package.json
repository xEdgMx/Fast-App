{
  "name": "super-app-delivery",
  "version": "0.1.0",
  "private": true,
  "description": "Super App de Delivery P2P + Mototaxis (monorepo)",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "api:dev": "npm run start:dev --workspace apps/api",
    "api:build": "npm run build --workspace apps/api",
    "api:start": "npm run start --workspace apps/api",
    "api:migrate": "npm run migrate --workspace apps/api",
    "api:seed": "npm run seed --workspace apps/api",
    "api:test": "npm run test --workspace apps/api"
  }
}
