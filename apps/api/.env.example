# Base de datos (local dev: SQLite). En producción: PostgreSQL.
# Postgres ejemplo: postgresql://user:pass@localhost:5432/superapp?schema=public
DATABASE_URL="file:./dev.db"

# Secreto para firmar los JWT. CAMBIAR en producción por un valor largo y aleatorio.
JWT_SECRET="dev-secret-cambiar-en-produccion"
JWT_EXPIRES_IN="7d"

# Puerto del servidor
PORT=3000
